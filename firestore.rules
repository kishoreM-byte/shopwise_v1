rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOrderStockDecrement(productId) {
      let orderId = request.resource.data.lastStockOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'lastStockOrderId'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && orderId is string
        && existsAfter(orderPath)
        && getAfter(orderPath).data.productId == productId
        && getAfter(orderPath).data.id == orderId
        && getAfter(orderPath).data.shopId == resource.data.shopId
        && getAfter(orderPath).data.ownerId == resource.data.ownerId
        && getAfter(orderPath).data.customerId == request.auth.uid
        && getAfter(orderPath).data.status == 'placed'
        && getAfter(orderPath).data.inventoryAdjusted == true
        && getAfter(orderPath).data.quantity is int
        && getAfter(orderPath).data.quantity > 0
        && resource.data.stock - request.resource.data.stock
            == getAfter(orderPath).data.quantity;
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }

      match /compare/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /shops/{shopId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.shopId is string
        && get(
          /databases/$(database)/documents/shops/$(request.resource.data.shopId)
        ).data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.isAvailable is bool
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 6
        && request.resource.data.rating is number
        && request.resource.data.reviewCount is number
        && request.resource.data.hasOffer is bool;

      allow update: if (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 6
        && (
          request.resource.data.shopId == resource.data.shopId
          ||
          (
            (!('shopId' in resource.data)
              || resource.data.shopId == '')
            && request.resource.data.shopId is string
            && get(
              /databases/$(database)/documents/shops/$(request.resource.data.shopId)
            ).data.ownerId == request.auth.uid
          )
        )
      ) || isOrderStockDecrement(productId);

      // Keep product records for historical orders and inventory restoration.
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.productId == productId
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 3
          && request.resource.data.comment.size() <= 500;

        allow update: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 3
          && request.resource.data.comment.size() <= 500;

        allow delete: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }

    match /enquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerId is string
        && request.resource.data.productId is string
        && request.resource.data.shopId is string
        && request.resource.data.ownerId ==
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId
        && request.resource.data.shopId ==
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.shopId
        && request.resource.data.ownerId ==
            get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerId;

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.productPrice == resource.data.productPrice
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.message == resource.data.message
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.status in ['accepted', 'rejected'];

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['orderId', 'purchaseStatus', 'purchasedAt', 'updatedAt'])
        && (!('orderId' in resource.data) || resource.data.orderId == '')
        && (!('purchaseStatus' in resource.data)
          || resource.data.purchaseStatus != 'purchased')
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.productPrice == resource.data.productPrice
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.message == resource.data.message
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.status == 'accepted'
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.purchaseStatus == 'purchased'
        && request.resource.data.purchasedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.customerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.enquiryId == enquiryId
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.productId == resource.data.productId
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.shopId == resource.data.shopId
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.ownerId == resource.data.ownerId
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.status == 'placed'
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.quantity == resource.data.quantity
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.unitPrice is number
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.subtotal is number
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.deliveryCharge is number
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.installationCharge is number
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.totalAmount is number
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.unitPrice >= 0
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.subtotal >= 0
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.deliveryCharge >= 0
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.installationCharge >= 0
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.totalAmount >= 0;

      allow delete: if signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status != 'accepted'
        && (!('orderId' in resource.data) || resource.data.orderId == '')
        && (!('purchaseStatus' in resource.data)
          || resource.data.purchaseStatus != 'purchased');
    }

      match /orders/{orderId} {
      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.id == orderId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.enquiryId is string
        && request.resource.data.productId is string
        && request.resource.data.shopId is string
        && request.resource.data.ownerId is string
        && request.resource.data.productName is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.inventoryAdjusted == true
        && request.resource.data.unitPrice is number
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryCharge is number
        && request.resource.data.installationCharge is number
        && request.resource.data.totalAmount is number
        && request.resource.data.subtotal ==
            request.resource.data.unitPrice * request.resource.data.quantity
        && request.resource.data.totalAmount ==
            request.resource.data.subtotal
            + request.resource.data.deliveryCharge
            + request.resource.data.installationCharge
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock is int
        && getAfter(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.stock ==
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock
            - request.resource.data.quantity
        && getAfter(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.lastStockOrderId == orderId
        && (
          (
            request.resource.data.enquiryId == ''
            && request.resource.data.purchaseMode in ['online', 'offline']
            && request.resource.data.fulfillmentType in ['delivery', 'pickup']
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.shopId == request.resource.data.shopId
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.ownerId == request.resource.data.ownerId
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.isAvailable == true
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.stock >= request.resource.data.quantity
            && get(
              /databases/$(database)/documents/shops/$(request.resource.data.shopId)
            ).data.ownerId == request.resource.data.ownerId
            && request.resource.data.productName ==
              get(
                /databases/$(database)/documents/products/$(request.resource.data.productId)
              ).data.name
            && request.resource.data.unitPrice ==
              get(
                /databases/$(database)/documents/products/$(request.resource.data.productId)
              ).data.price
            && (
              (
                request.resource.data.purchaseMode == 'online'
                && request.resource.data.fulfillmentType == 'delivery'
                && get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.deliveryAvailable == true
                && request.resource.data.deliveryCharge ==
                  get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data.deliveryCharge
              )
              ||
              (
                request.resource.data.purchaseMode == 'offline'
                && request.resource.data.fulfillmentType == 'pickup'
                && request.resource.data.deliveryCharge == 0
              )
            )
            && (
              (
                'installationAvailable' in get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data
                &&
                get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.installationAvailable == true
                && request.resource.data.installationCharge == get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.installationCharge
              )
              || (
                (
                  !('installationAvailable' in get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data)
                  || get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data.installationAvailable == false
                )
                && request.resource.data.installationCharge == 0
              )
            )
          )
          ||
          (
            request.resource.data.enquiryId != ''
            && orderId == request.resource.data.enquiryId
            && (
              !('purchaseMode' in request.resource.data)
              || request.resource.data.purchaseMode == 'enquiry'
            )
            && request.resource.data.quantity == get(
              /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
            ).data.quantity
            && get(
              /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
            ).data.customerId == request.auth.uid
            && get(
              /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
            ).data.status == 'accepted'
            && get(
              /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
            ).data.productId == request.resource.data.productId
            && get(
              /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
            ).data.shopId == request.resource.data.shopId
            && get(
              /databases/$(database)/documents/shops/$(request.resource.data.shopId)
            ).data.ownerId == request.resource.data.ownerId
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.shopId == request.resource.data.shopId
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.ownerId == request.resource.data.ownerId
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.isAvailable == true
            && get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.stock >= request.resource.data.quantity
            && request.resource.data.productName == get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.name
            && request.resource.data.unitPrice == get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.price
            && (
              (
                'deliveryAvailable' in get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data
                &&
                get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.deliveryAvailable == true
                && request.resource.data.deliveryCharge == get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.deliveryCharge
              )
              || (
                (
                  !('deliveryAvailable' in get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data)
                  || get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data.deliveryAvailable == false
                )
                && request.resource.data.deliveryCharge == 0
              )
            )
            && (
              (
                'installationAvailable' in get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data
                &&
                get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.installationAvailable == true
                && request.resource.data.installationCharge == get(
                  /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                ).data.installationCharge
              )
              || (
                (
                  !('installationAvailable' in get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data)
                  || get(
                    /databases/$(database)/documents/shops/$(request.resource.data.shopId)
                  ).data.installationAvailable == false
                )
                && request.resource.data.installationCharge == 0
              )
            )
          )
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'inventoryAdjusted', 'updatedAt'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.enquiryId == resource.data.enquiryId
        && (
          (!('purchaseMode' in resource.data)
            && !('purchaseMode' in request.resource.data))
          || request.resource.data.purchaseMode == resource.data.purchaseMode
        )
        && (
          (!('fulfillmentType' in resource.data)
            && !('fulfillmentType' in request.resource.data))
          || request.resource.data.fulfillmentType == resource.data.fulfillmentType
        )
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.unitPrice == resource.data.unitPrice
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.deliveryCharge == resource.data.deliveryCharge
        && request.resource.data.installationCharge == resource.data.installationCharge
        && request.resource.data.totalAmount == resource.data.totalAmount
        && (
          (
            !('inventoryAdjusted' in resource.data)
            && !('inventoryAdjusted' in request.resource.data)
          )
          || (
            request.resource.data.inventoryAdjusted == resource.data.inventoryAdjusted
            && !(
              request.resource.data.status == 'cancelled'
              && resource.data.inventoryAdjusted == true
            )
          )
          || (
            resource.data.inventoryAdjusted == true
            && request.resource.data.inventoryAdjusted == false
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['placed', 'accepted']
            && exists(
              /databases/$(database)/documents/products/$(resource.data.productId)
            )
            && get(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.stock is int
            && get(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.stock >= 0
            && getAfter(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.stock is int
            && getAfter(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.stock >= 0
            && getAfter(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.stock ==
              get(
                /databases/$(database)/documents/products/$(resource.data.productId)
              ).data.stock + resource.data.quantity
            && getAfter(
              /databases/$(database)/documents/products/$(resource.data.productId)
            ).data.lastStockOrderId == orderId
          )
        )
        && request.resource.data.status in ['placed', 'accepted', 'completed', 'cancelled']
        && (
          (
            resource.data.status == 'placed'
            && request.resource.data.status in ['accepted', 'cancelled']
          )
          ||
          (
            resource.data.status == 'accepted'
            && request.resource.data.status in ['completed', 'cancelled']
          )
        )
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /notifications/{notificationId} {
        allow read: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow create: if signedIn()
          && notificationId ==
              request.resource.data.enquiryId +
              (request.resource.data.type == 'enquiry_accepted'
                ? '_accepted'
                : '_rejected')
          && request.resource.data.id == notificationId
          && request.resource.data.isRead == false
          && request.resource.data.type in ['enquiry_accepted', 'enquiry_rejected']
          && request.resource.data.title ==
              (request.resource.data.type == 'enquiry_accepted'
                ? 'Enquiry accepted'
                : 'Enquiry rejected')
          && request.resource.data.enquiryId is string
          && request.resource.data.productId is string
          && request.resource.data.shopId is string
          && request.resource.data.userId is string
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.ownerId == request.auth.uid
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.customerId == request.resource.data.userId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.productId == request.resource.data.productId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.shopId == request.resource.data.shopId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.status ==
              (request.resource.data.type == 'enquiry_accepted'
                ? 'accepted'
                : 'rejected');

        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.type == resource.data.type
          && request.resource.data.title == resource.data.title
          && request.resource.data.message == resource.data.message
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.enquiryId == resource.data.enquiryId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.isRead == true;

        allow delete: if false;
      }

  }
}
