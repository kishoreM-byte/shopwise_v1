rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }

      match /compare/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /shops/{shopId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow update: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow delete: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }

    match /enquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerId is string
        && request.resource.data.productId is string
        && request.resource.data.shopId is string
        && request.resource.data.ownerId ==
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId
        && request.resource.data.shopId ==
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.shopId
        && request.resource.data.ownerId ==
            get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerId;

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.productPrice == resource.data.productPrice
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.message == resource.data.message
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if signedIn()
        && resource.data.customerId == request.auth.uid;
    }

      match /notifications/{notificationId} {
        allow read: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow create: if signedIn()
          && notificationId ==
              request.resource.data.enquiryId +
              (request.resource.data.type == 'enquiry_accepted'
                ? '_accepted'
                : '_rejected')
          && request.resource.data.id == notificationId
          && request.resource.data.isRead == false
          && request.resource.data.type in ['enquiry_accepted', 'enquiry_rejected']
          && request.resource.data.title ==
              (request.resource.data.type == 'enquiry_accepted'
                ? 'Enquiry accepted'
                : 'Enquiry rejected')
          && request.resource.data.enquiryId is string
          && request.resource.data.productId is string
          && request.resource.data.shopId is string
          && request.resource.data.userId is string
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.ownerId == request.auth.uid
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.customerId == request.resource.data.userId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.productId == request.resource.data.productId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.shopId == request.resource.data.shopId
          && getAfter(
                /databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId)
              ).data.status ==
              (request.resource.data.type == 'enquiry_accepted'
                ? 'accepted'
                : 'rejected');

        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.type == resource.data.type
          && request.resource.data.title == resource.data.title
          && request.resource.data.message == resource.data.message
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.enquiryId == resource.data.enquiryId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.isRead == true;

        allow delete: if false;
      }

  }
}
