import 'package:flutter/material.dart';

import '../../theme/design_tokens.dart';
import 'widgets/home/home_product_results.dart';
import 'widgets/home/home_saved_products.dart';

import '../../models/product.dart';
import '../../services/product_service.dart';
import '../../services/customer/wishlist_service.dart';
import '../../services/customer/compare_service.dart';

import '../profile/profile_screen.dart';
import 'widgets/home/home_welcome_section.dart';
import 'widgets/home/home_quick_actions.dart';
import 'widgets/home/home_feature_grid.dart';
import 'widgets/home/home_empty_state.dart';
import 'widgets/home/home_search_bar.dart';
import 'best_deals_screen.dart';
import 'nearby_shops_screen.dart';
import 'smart_score_screen.dart';
import 'smart_trip_screen.dart';
import 'notifications_screen.dart';
import 'my_enquiries_screen.dart';

class _PremiumPressable extends StatefulWidget {
  const _PremiumPressable({required this.child, required this.onTap});

  final Widget child;
  final VoidCallback onTap;

  @override
  State<_PremiumPressable> createState() => _PremiumPressableState();
}

class _PremiumPressableState extends State<_PremiumPressable> {
  bool _pressed = false;

  @override
  Widget build(BuildContext context) {
    return AnimatedScale(
      scale: _pressed ? 0.975 : 1.0,
      duration: ShopWiseMotion.micro,
      curve: ShopWiseMotion.standardCurve,
      child: Listener(
        onPointerDown: (_) {
          if (mounted) setState(() => _pressed = true);
        },
        onPointerUp: (_) {
          if (mounted) setState(() => _pressed = false);
        },
        onPointerCancel: (_) {
          if (mounted) setState(() => _pressed = false);
        },
        child: Material(
          color: Colors.transparent,
          borderRadius: BorderRadius.circular(ShopWiseRadius.large),
          child: InkWell(
            borderRadius: BorderRadius.circular(ShopWiseRadius.large),
            onTap: widget.onTap,
            child: widget.child,
          ),
        ),
      ),
    );
  }
}

class CustomerHomeScreen extends StatefulWidget {
  const CustomerHomeScreen({super.key});

  @override
  State<CustomerHomeScreen> createState() => _CustomerHomeScreenState();
}

class _CustomerHomeScreenState extends State<CustomerHomeScreen> {
  int _currentIndex = 0;
  int _previousIndex = 0;

  String _searchQuery = '';

  String? _selectedCategory;
  double? _minPrice;
  double? _maxPrice;
  bool _availableOnly = false;

  List<String> _cachedProductCategories = <String>[];

  final TextEditingController _searchController = TextEditingController();

  final WishlistService _wishlistService = WishlistService();
  final CompareService _compareService = CompareService();

  Set<String> _wishlistIds = <String>{};
  Set<String> _compareIds = <String>{};

  Stream<Set<String>> get _wishlistStream =>
      _wishlistService.watchWishlistIds();

  Stream<Set<String>> get _compareStream => _compareService.watchCompareIds();

  final List<String> _titles = const [
    'ShopWise',
    'Search',
    'Compare',
    'Wishlist',
    'Profile',
  ];

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  void _onNavigationTap(int index) {
    if (index == _currentIndex) return;

    setState(() {
      _previousIndex = _currentIndex;
      _currentIndex = index;
    });

    // Profile is currently implemented as a separate screen.
    if (index == 4) {
      Navigator.push(
        context,
        MaterialPageRoute(builder: (_) => const ProfileScreen()),
      ).then((_) {
        if (!mounted) return;

        setState(() {
          _currentIndex = 0;
        });
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: ShopWiseColors.background,

      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        title: Text(
          _titles[_currentIndex],
          style: const TextStyle(
            fontWeight: FontWeight.bold,
            color: ShopWiseColors.textPrimary,
          ),
        ),
        actions: [
          IconButton(
            tooltip: 'Notifications',
            onPressed: () => _openFeature(const NotificationsScreen()),
            icon: const Icon(
              Icons.notifications_none,
              color: ShopWiseColors.textPrimary,
            ),
          ),
        ],
      ),

      body: StreamBuilder<Set<String>>(
        stream: _wishlistStream,
        builder: (context, wishlistSnapshot) {
          _wishlistIds = wishlistSnapshot.data ?? <String>{};

          return StreamBuilder<Set<String>>(
            stream: _compareStream,
            builder: (context, compareSnapshot) {
              _compareIds = compareSnapshot.data ?? <String>{};
              return AnimatedSwitcher(
                duration: ShopWiseMotion.page,
                reverseDuration: ShopWiseMotion.fast,
                switchInCurve: ShopWiseMotion.entranceCurve,
                switchOutCurve: ShopWiseMotion.standardCurve,
                transitionBuilder: (child, animation) {
                  final bool movingForward = _currentIndex >= _previousIndex;

                  final Offset begin = movingForward
                      ? const Offset(0.035, 0)
                      : const Offset(-0.035, 0);

                  final Animation<Offset> slide =
                      Tween<Offset>(begin: begin, end: Offset.zero).animate(
                        CurvedAnimation(
                          parent: animation,
                          curve: ShopWiseMotion.entranceCurve,
                        ),
                      );

                  return FadeTransition(
                    opacity: animation,
                    child: SlideTransition(position: slide, child: child),
                  );
                },
                child: KeyedSubtree(
                  key: ValueKey<int>(_currentIndex),
                  child: _buildBody(),
                ),
              );
            },
          );
        },
      ),

      bottomNavigationBar: NavigationBar(
        selectedIndex: _currentIndex,
        onDestinationSelected: _onNavigationTap,

        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.search_outlined),
            selectedIcon: Icon(Icons.search),
            label: 'Search',
          ),
          NavigationDestination(
            icon: Icon(Icons.compare_arrows_outlined),
            selectedIcon: Icon(Icons.compare_arrows),
            label: 'Compare',
          ),
          NavigationDestination(
            icon: Icon(Icons.favorite_border),
            selectedIcon: Icon(Icons.favorite),
            label: 'Wishlist',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person),
            label: 'Profile',
          ),
        ],
      ),
    );
  }

  Widget _buildBody() {
    switch (_currentIndex) {
      case 0:
        return _buildHome();

      case 1:
        return _buildSearch();

      case 2:
        return _buildCompare();

      case 3:
        return _buildWishlist();

      case 4:
        // Profile opens as a separate screen.
        return _buildHome();

      default:
        return _buildHome();
    }
  }

  // ---------------------------------------------------------------------------
  // HOME
  // ---------------------------------------------------------------------------

  Widget _buildHome() {
    return SafeArea(
      child: SingleChildScrollView(
        physics: const BouncingScrollPhysics(),
        padding: const EdgeInsets.fromLTRB(20, 10, 20, 32),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _buildWelcomeSection(),
            const SizedBox(height: 22),
            _buildSearchBar(),
            const SizedBox(height: 28),
            _buildSectionTitle(title: 'Quick Actions', actionText: null),
            const SizedBox(height: 12),
            _buildQuickActions(),
            const SizedBox(height: 30),
            _buildSectionTitle(title: 'Explore ShopWise', actionText: null),
            const SizedBox(height: 12),
            _buildFeatureGrid(),
            const SizedBox(height: 28),
          ],
        ),
      ),
    );
  }

  Widget _buildWelcomeSection() {
    return const HomeWelcomeSection();
  }

  Widget _buildSearchBar() {
    return HomeSearchBar(
      onTap: () {
        setState(() {
          _currentIndex = 1;
        });
      },
    );
  }

  Widget _buildQuickActions() {
    return HomeQuickActions(
      onCompare: () {
        setState(() {
          _previousIndex = _currentIndex;
          _currentIndex = 2;
        });
      },
      onWishlist: () {
        setState(() {
          _previousIndex = _currentIndex;
          _currentIndex = 3;
        });
      },
      onEnquiries: () => _openFeature(const MyEnquiriesScreen()),
    );
  }

  Widget _buildFeatureGrid() {
    return HomeFeatureGrid(
      onNearbyShops: () => _openFeature(const NearbyShopsScreen()),
      onBestDeals: () => _openFeature(const BestDealsScreen()),
      onSmartScore: () => _openFeature(const SmartScoreScreen()),
      onSmartTrip: () => _openFeature(const SmartTripScreen()),
      onEnquiries: () => _openFeature(const MyEnquiriesScreen()),
    );
  }

  Widget _buildSearch() {
    final ProductService productService = ProductService();

    return SafeArea(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: StreamBuilder<List<Product>>(
          stream: productService.watchAllProducts(),
          builder: (context, snapshot) {
            if (snapshot.connectionState == ConnectionState.waiting) {
              return const Center(
                child: CircularProgressIndicator(color: ShopWiseColors.emerald),
              );
            }

            if (snapshot.hasError) {
              return HomeEmptyState(
                icon: Icons.error_outline,
                title: 'Unable to load products',
                subtitle: 'Please try again later.',
              );
            }

            final products = snapshot.data ?? const <Product>[];

            _cachedProductCategories =
                products
                    .map((product) => product.category.trim())
                    .where((category) => category.isNotEmpty)
                    .toSet()
                    .toList()
                  ..sort();

            return Column(
              children: [
                TextField(
                  controller: _searchController,
                  onChanged: (value) {
                    setState(() {
                      _searchQuery = value.trim().toLowerCase();
                    });
                  },
                  decoration: InputDecoration(
                    hintText: 'Search products or shops...',
                    prefixIcon: const Icon(Icons.search),
                    suffixIcon: IconButton(
                      onPressed: () => _showSearchFilters(context),
                      icon: const Icon(Icons.tune),
                    ),
                    filled: true,
                    fillColor: ShopWiseColors.surface,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(
                        ShopWiseRadius.medium,
                      ),
                      borderSide: BorderSide.none,
                    ),
                  ),
                ),

                const SizedBox(height: 20),

                Expanded(child: _buildProductResults(products)),
              ],
            );
          },
        ),
      ),
    );
  }

  Widget _buildProductResults(List<Product> products) {
    return HomeProductResults(
      products: products,
      searchQuery: _searchQuery,
      selectedCategory: _selectedCategory,
      minPrice: _minPrice,
      maxPrice: _maxPrice,
      availableOnly: _availableOnly,
      onEmptyState: ({
        required IconData icon,
        required String title,
        required String subtitle,
      }) {
        return HomeEmptyState(
          icon: icon,
          title: title,
          subtitle: subtitle,
        );
      },
    );
  }

  // ---------------------------------------------------------------------------
  // COMPARE
  // ---------------------------------------------------------------------------

  Widget _buildCompare() {
    return HomeSavedProducts(
      ids: _compareIds,
      icon: Icons.compare_arrows_rounded,
      title: 'Compare Products',
      emptySubtitle: 'Add products using Compare to see them here.',
      compareIds: _compareIds,
      wishlistIds: _wishlistIds,
    );
  }

  Widget _buildWishlist() {
    return HomeSavedProducts(
      ids: _wishlistIds,
      icon: Icons.favorite_rounded,
      title: 'Your Wishlist',
      emptySubtitle: 'Products you save will appear here.',
      compareIds: _compareIds,
      wishlistIds: _wishlistIds,
    );
  }

  Widget _buildSectionTitle({required String title, String? actionText}) {
    return Row(
      children: [
        Expanded(
          child: Text(
            title,
            style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
          ),
        ),
        if (actionText != null)
          TextButton(onPressed: _showComingSoon, child: Text(actionText)),
      ],
    );
  }

  void _showSearchFilters(BuildContext context) {
    String? category = _selectedCategory;
    double? minPrice = _minPrice;
    double? maxPrice = _maxPrice;
    bool availableOnly = _availableOnly;

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      showDragHandle: true,
      backgroundColor: ShopWiseColors.surface,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(
          top: Radius.circular(ShopWiseRadius.sheet),
        ),
      ),
      builder: (sheetContext) {
        return StatefulBuilder(
          builder: (context, setSheetState) {
            final categories = <String>{
              'All',
              ..._cachedProductCategories,
            }.toList();

            return SafeArea(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(20, 4, 20, 24),
                child: SingleChildScrollView(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'Search filters',
                        style: TextStyle(
                          fontSize: 22,
                          fontWeight: FontWeight.w800,
                          color: ShopWiseColors.textPrimary,
                        ),
                      ),
                      const SizedBox(height: 6),
                      const Text(
                        'Refine products by category, price and availability.',
                        style: TextStyle(
                          fontSize: 13,
                          color: ShopWiseColors.textSecondary,
                        ),
                      ),
                      const SizedBox(height: 22),

                      const Text(
                        'Category',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                          color: ShopWiseColors.textPrimary,
                        ),
                      ),
                      const SizedBox(height: 10),

                      Wrap(
                        spacing: 8,
                        runSpacing: 8,
                        children: categories.map((item) {
                          final selected = item == 'All'
                              ? category == null
                              : category == item;

                          return ChoiceChip(
                            label: Text(item),
                            selected: selected,
                            onSelected: (_) {
                              setSheetState(() {
                                category = item == 'All' ? null : item;
                              });
                            },
                          );
                        }).toList(),
                      ),

                      const SizedBox(height: 24),

                      const Text(
                        'Price range',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                          color: ShopWiseColors.textPrimary,
                        ),
                      ),
                      const SizedBox(height: 10),

                      DropdownButtonFormField<String>(
                        initialValue: _priceRangeLabel(minPrice, maxPrice),
                        decoration: InputDecoration(
                          filled: true,
                          fillColor: ShopWiseColors.background,
                          border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(
                              ShopWiseRadius.small,
                            ),
                            borderSide: const BorderSide(
                              color: ShopWiseColors.border,
                            ),
                          ),
                          enabledBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(
                              ShopWiseRadius.small,
                            ),
                            borderSide: const BorderSide(
                              color: ShopWiseColors.border,
                            ),
                          ),
                        ),
                        hint: const Text('Any price'),
                        items: const [
                          DropdownMenuItem(
                            value: 'Any price',
                            child: Text('Any price'),
                          ),
                          DropdownMenuItem(
                            value: 'Under ₹1,000',
                            child: Text('Under ₹1,000'),
                          ),
                          DropdownMenuItem(
                            value: '₹1,000 – ₹5,000',
                            child: Text('₹1,000 – ₹5,000'),
                          ),
                          DropdownMenuItem(
                            value: '₹5,000 – ₹10,000',
                            child: Text('₹5,000 – ₹10,000'),
                          ),
                          DropdownMenuItem(
                            value: 'Above ₹10,000',
                            child: Text('Above ₹10,000'),
                          ),
                        ],
                        onChanged: (value) {
                          setSheetState(() {
                            switch (value) {
                              case 'Under ₹1,000':
                                minPrice = 0;
                                maxPrice = 1000;
                                break;
                              case '₹1,000 – ₹5,000':
                                minPrice = 1000;
                                maxPrice = 5000;
                                break;
                              case '₹5,000 – ₹10,000':
                                minPrice = 5000;
                                maxPrice = 10000;
                                break;
                              case 'Above ₹10,000':
                                minPrice = 10000;
                                maxPrice = null;
                                break;
                              default:
                                minPrice = null;
                                maxPrice = null;
                            }
                          });
                        },
                      ),

                      const SizedBox(height: 12),

                      SwitchListTile.adaptive(
                        contentPadding: EdgeInsets.zero,
                        title: const Text(
                          'Available products only',
                          style: TextStyle(fontWeight: FontWeight.w700),
                        ),
                        subtitle: const Text(
                          'Hide products that are out of stock.',
                          style: TextStyle(fontSize: 12),
                        ),
                        value: availableOnly,
                        onChanged: (value) {
                          setSheetState(() {
                            availableOnly = value;
                          });
                        },
                      ),

                      const SizedBox(height: 18),

                      Row(
                        children: [
                          Expanded(
                            child: OutlinedButton(
                              onPressed: () {
                                setState(() {
                                  _selectedCategory = null;
                                  _minPrice = null;
                                  _maxPrice = null;
                                  _availableOnly = false;
                                });
                                Navigator.pop(sheetContext);
                              },
                              style: OutlinedButton.styleFrom(
                                minimumSize: const Size.fromHeight(52),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(
                                    ShopWiseRadius.small,
                                  ),
                                ),
                              ),
                              child: const Text('Reset'),
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: FilledButton(
                              onPressed: () {
                                setState(() {
                                  _selectedCategory = category;
                                  _minPrice = minPrice;
                                  _maxPrice = maxPrice;
                                  _availableOnly = availableOnly;
                                });
                                Navigator.pop(sheetContext);
                              },
                              style: FilledButton.styleFrom(
                                minimumSize: const Size.fromHeight(52),
                                backgroundColor: ShopWiseColors.emerald,
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(
                                    ShopWiseRadius.small,
                                  ),
                                ),
                              ),
                              child: const Text('Apply filters'),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
              ),
            );
          },
        );
      },
    );
  }

  String? _priceRangeLabel(double? min, double? max) {
    if (min == null && max == null) return 'Any price';
    if (min == 0 && max == 1000) return 'Under ₹1,000';
    if (min == 1000 && max == 5000) return '₹1,000 – ₹5,000';
    if (min == 5000 && max == 10000) return '₹5,000 – ₹10,000';
    if (min == 10000 && max == null) return 'Above ₹10,000';
    return null;
  }

  void _openFeature(Widget screen) {
    Navigator.push(context, MaterialPageRoute(builder: (_) => screen));
  }

  void _showComingSoon() {
    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('This ShopWise feature will be connected next.'),
        duration: Duration(seconds: 2),
      ),
    );
  }
}
