import '../models/product.dart';
import 'true_cost_service.dart';

class SmartScoreResult {
  final double score;
  final double valueScore;
  final double qualityScore;
  final double availabilityScore;
  final double offerScore;

  final double travelCost;
  final double deliveryCost;
  final double installationCost;

  final double trueCost;

  const SmartScoreResult({
    required this.score,
    required this.valueScore,
    required this.qualityScore,
    required this.availabilityScore,
    required this.offerScore,
    required this.travelCost,
    required this.deliveryCost,
    required this.installationCost,
    required this.trueCost,
  });

  String get scoreLabel {
    if (score >= 85) return 'Excellent choice';
    if (score >= 70) return 'Good choice';
    if (score >= 55) return 'Fair choice';
    return 'Needs consideration';
  }

  String get scoreDescription {
    if (score >= 85) {
      return 'Strong value based on price, quality, reviews and availability.';
    }

    if (score >= 70) {
      return 'A solid option with a good overall balance.';
    }

    if (score >= 55) {
      return 'Worth considering, but compare other options before buying.';
    }

    return 'Consider comparing price, quality and other available options.';
  }
}

class SmartScoreService {
  const SmartScoreService();

  SmartScoreResult calculate(
    Product product, {
    double travelCost = 0,
    double deliveryCost = 0,
    double installationCost = 0,
  }) {
    final double valueScore = _calculateValueScore(product);
    final double qualityScore = _calculateQualityScore(product);
    final double availabilityScore = _calculateAvailabilityScore(product);
    final double offerScore = _calculateOfferScore(product);

    final double baseScore =
        (valueScore * 0.35) +
        (qualityScore * 0.35) +
        (availabilityScore * 0.15) +
        (offerScore * 0.15);

    final TrueCostResult trueCostResult = const TrueCostService().calculate(
      productPrice: product.price,
      travelCost: travelCost,
      deliveryCost: deliveryCost,
      installationCost: installationCost,
    );

    final double totalAdditionalCost = trueCostResult.additionalCost;

    final double travelImpact = _calculateCostImpact(
      product.price,
      totalAdditionalCost,
    );

    final double finalScore = _clamp(
      baseScore - travelImpact,
      0,
      100,
    );

    return SmartScoreResult(
      score: finalScore,
      valueScore: valueScore,
      qualityScore: qualityScore,
      availabilityScore: availabilityScore,
      offerScore: offerScore,
      travelCost: trueCostResult.travelCost,
      deliveryCost: trueCostResult.deliveryCost,
      installationCost: trueCostResult.installationCost,
      trueCost: trueCostResult.totalCost,
    );
  }

  double _calculateValueScore(Product product) {
    if (product.price <= 0) {
      return 0;
    }

    double score = 50;

    final double? originalPrice = product.originalPrice;

    if (originalPrice != null && originalPrice > product.price) {
      final double discount =
          ((originalPrice - product.price) / originalPrice) * 100;

      score += _clamp(discount * 0.9, 0, 30);
    }

    if (product.hasOffer) {
      score += 10;
    }

    return _clamp(score, 0, 100);
  }

  double _calculateQualityScore(Product product) {
    if (product.rating <= 0) {
      return 50;
    }

    final double ratingScore =
        _clamp((product.rating / 5) * 80, 0, 80);

    final double reviewConfidence =
        _reviewConfidence(product.reviewCount);

    return _clamp(
      ratingScore + reviewConfidence,
      0,
      100,
    );
  }

  double _reviewConfidence(int reviewCount) {
    if (reviewCount <= 0) return 0;
    if (reviewCount >= 500) return 20;
    if (reviewCount >= 100) return 16;
    if (reviewCount >= 50) return 13;
    if (reviewCount >= 20) return 10;
    if (reviewCount >= 10) return 7;
    if (reviewCount >= 5) return 4;

    return 2;
  }

  double _calculateAvailabilityScore(Product product) {
    if (!product.isAvailable || product.stock <= 0) {
      return 20;
    }

    if (product.stock <= 2) {
      return 70;
    }

    if (product.stock <= 5) {
      return 85;
    }

    return 100;
  }

  double _calculateOfferScore(Product product) {
    if (!product.hasOffer) {
      return 40;
    }

    if (product.offerText == null ||
        product.offerText!.trim().isEmpty) {
      return 55;
    }

    return 100;
  }

  double _calculateCostImpact(
    double productPrice,
    double additionalCost,
  ) {
    if (productPrice <= 0 || additionalCost <= 0) {
      return 0;
    }

    final double additionalCostPercentage =
        (additionalCost / productPrice) * 100;

    return _clamp(
      additionalCostPercentage * 0.35,
      0,
      20,
    );
  }

  double _clamp(
    double value,
    double minimum,
    double maximum,
  ) {
    if (value < minimum) return minimum;
    if (value > maximum) return maximum;
    return value;
  }
}
