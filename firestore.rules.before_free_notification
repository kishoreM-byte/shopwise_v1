rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }

      match /compare/{productId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /shops/{shopId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow update: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow delete: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }

    match /enquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.productPrice == resource.data.productPrice
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.message == resource.data.message
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if signedIn()
        && resource.data.customerId == request.auth.uid;
    }

      match /notifications/{notificationId} {
        allow read: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow create: if false;

        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.type == resource.data.type
          && request.resource.data.title == resource.data.title
          && request.resource.data.message == resource.data.message
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.enquiryId == resource.data.enquiryId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.isRead == true;

        allow delete: if false;
      }

    match /connection_test/{documentId} {
      allow read, write: if signedIn();
    }
  }
}
